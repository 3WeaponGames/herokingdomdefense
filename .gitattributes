# Store text consistently across computers; preserve Cocos asset UUIDs in .meta.
* text=auto
*.js text eol=lf
*.cjs text eol=lf
*.ts text eol=lf
*.json text eol=lf
*.meta text eol=lf
*.atlas text eol=lf
*.prefab text eol=lf
*.fire text eol=lf
*.md text eol=lf
*.py text eol=lf
*.toml text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.csv text eol=lf
*.tsv text eol=lf
*.ps1 text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf

*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.mp3 binary
*.wav binary
*.ogg binary
*.ttf binary
*.otf binary
*.rar binary
*.zip binary

# Preserve the bundled publisher guides exactly as supplied.
assets/resources/unit-library/**/*.txt -text whitespace=-blank-at-eol
