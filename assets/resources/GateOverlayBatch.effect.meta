      "glsl1": {
        "vert": "\nprecision highp float;\nuniform mat4 cc_matViewProj;\nattribute vec3 a_position;\nattribute vec2 a_wallUv;\nattribute vec2 a_actorUv;\nattribute vec4 a_color;\nattribute vec4 a_clip;\nattribute float a_paintActor;\nvarying vec2 v_wallUv;\nvarying vec2 v_actorUv;\nvarying vec4 v_color;\nvarying vec4 v_clip;\nvarying float v_paintActor;\nvoid main () {\n  gl_Position = cc_matViewProj * vec4(a_position, 1);\n  v_wallUv = a_wallUv;\n  v_actorUv = a_actorUv;\n  v_color = a_color;\n  v_clip = a_clip;\n  v_paintActor = a_paintActor;\n}",
        "frag": "\nprecision highp float;\nvarying vec2 v_wallUv;\nvarying vec2 v_actorUv;\nvarying vec4 v_color;\nvarying vec4 v_clip;\nvarying float v_paintActor;\nuniform sampler2D texture;\nuniform sampler2D maskTexture;\nvoid main () {\n  if (v_clip.x < 0.0 || v_clip.y < 0.0 || v_clip.x > 1.0 || v_clip.y > 1.0) discard;\n  vec4 wall = vec4(1), actor = vec4(1);\n  #if USE_TEXTURE\n  vec4 texture_tmp = texture2D(texture, v_wallUv);\n  #if CC_USE_ALPHA_ATLAS_texture\n      texture_tmp.a *= texture2D(texture, v_wallUv + vec2(0, 0.5)).r;\n  #endif\n  #if INPUT_IS_GAMMA\n    wall.rgb *= (texture_tmp.rgb * texture_tmp.rgb);\n    wall.a *= texture_tmp.a;\n  #else\n    wall *= texture_tmp;\n  #endif\n  vec4 maskTexture_tmp = texture2D(maskTexture, v_actorUv);\n  #if CC_USE_ALPHA_ATLAS_maskTexture\n      maskTexture_tmp.a *= texture2D(maskTexture, v_actorUv + vec2(0, 0.5)).r;\n  #endif\n  #if INPUT_IS_GAMMA\n    actor.rgb *= (maskTexture_tmp.rgb * maskTexture_tmp.rgb);\n    actor.a *= maskTexture_tmp.a;\n  #else\n    actor *= maskTexture_tmp;\n  #endif\n  #endif\n  vec4 stencil = mix(actor, wall, v_paintActor);\n  if (stencil.a * v_clip.z < v_clip.w) discard;\n  vec4 o = mix(wall, actor, v_paintActor) * v_color;\n  #if USE_BGRA\n    gl_FragColor = o.bgra;\n  #else\n    gl_FragColor = o.rgba;\n  #endif\n}"
      },
      "glsl3": {
        "vert": "\nprecision highp float;\nuniform CCGlobal {\n  mat4 cc_matView;\n  mat4 cc_matViewInv;\n  mat4 cc_matProj;\n  mat4 cc_matProjInv;\n  mat4 cc_matViewProj;\n  mat4 cc_matViewProjInv;\n  vec4 cc_cameraPos;\n  vec4 cc_time;\n  mediump vec4 cc_screenSize;\n  mediump vec4 cc_screenScale;\n};\nin vec3 a_position;\nin vec2 a_wallUv;\nin vec2 a_actorUv;\nin vec4 a_color;\nin vec4 a_clip;\nin float a_paintActor;\nout vec2 v_wallUv;\nout vec2 v_actorUv;\nout vec4 v_color;\nout vec4 v_clip;\nout float v_paintActor;\nvoid main () {\n  gl_Position = cc_matViewProj * vec4(a_position, 1);\n  v_wallUv = a_wallUv;\n  v_actorUv = a_actorUv;\n  v_color = a_color;\n  v_clip = a_clip;\n  v_paintActor = a_paintActor;\n}",
        "frag": "\nprecision highp float;\nin vec2 v_wallUv;\nin vec2 v_actorUv;\nin vec4 v_color;\nin vec4 v_clip;\nin float v_paintActor;\nuniform sampler2D texture;\nuniform sampler2D maskTexture;\nvoid main () {\n  if (v_clip.x < 0.0 || v_clip.y < 0.0 || v_clip.x > 1.0 || v_clip.y > 1.0) discard;\n  vec4 wall = vec4(1), actor = vec4(1);\n  #if USE_TEXTURE\n  vec4 texture_tmp = texture(texture, v_wallUv);\n  #if CC_USE_ALPHA_ATLAS_texture\n      texture_tmp.a *= texture(texture, v_wallUv + vec2(0, 0.5)).r;\n  #endif\n  #if INPUT_IS_GAMMA\n    wall.rgb *= (texture_tmp.rgb * texture_tmp.rgb);\n    wall.a *= texture_tmp.a;\n  #else\n    wall *= texture_tmp;\n  #endif\n  vec4 maskTexture_tmp = texture(maskTexture, v_actorUv);\n  #if CC_USE_ALPHA_ATLAS_maskTexture\n      maskTexture_tmp.a *= texture(maskTexture, v_actorUv + vec2(0, 0.5)).r;\n  #endif\n  #if INPUT_IS_GAMMA\n    actor.rgb *= (maskTexture_tmp.rgb * maskTexture_tmp.rgb);\n    actor.a *= maskTexture_tmp.a;\n  #else\n    actor *= maskTexture_tmp;\n  #endif\n  #endif\n  vec4 stencil = mix(actor, wall, v_paintActor);\n  if (stencil.a * v_clip.z < v_clip.w) discard;\n  vec4 o = mix(wall, actor, v_paintActor) * v_color;\n  #if USE_BGRA\n    gl_FragColor = o.bgra;\n  #else\n    gl_FragColor = o.rgba;\n  #endif\n}"
