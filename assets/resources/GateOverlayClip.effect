// Native unit/wall overlay: one original paint Sprite, fragment-clipped
// by the original independent image-stencil alpha. No overlay union/reordering.
CCEffect %{
  techniques:
  - passes:
    - vert: vs
      frag: fs
      blendState:
        targets:
        - blend: true
      rasterizerState:
        cullMode: none
      properties:
        texture: { value: white }
        maskTexture: { value: white }
        maskMap: { value: [1, 1, 0, 0] }
        maskRect: { value: [0, 0, 1, 1] }
        maskOpacity: { value: 1 }
        alphaThreshold: { value: 0.1 }
}%

CCProgram vs %{
  precision highp float;
  #include <cc-global>
  #include <cc-local>
  in vec3 a_position;
  in vec4 a_color;
  #if USE_TEXTURE
  in vec2 a_uv0;
  #endif
  uniform ClipMap {
    vec4 maskMap;
  };
  out vec4 v_color;
  out vec2 v_uv0;
  out vec2 v_maskUV;
  void main () {
    vec4 pos = vec4(a_position, 1);
    #if CC_USE_MODEL
      pos = cc_matViewProj * cc_matWorld * pos;
    #else
      pos = cc_matViewProj * pos;
    #endif
    v_color = a_color;
    #if USE_TEXTURE
      v_uv0 = a_uv0;
      v_maskUV = a_uv0 * maskMap.xy + maskMap.zw;
    #else
      v_uv0 = vec2(0);
      v_maskUV = vec2(0);
    #endif
    gl_Position = pos;
  }
}%

CCProgram fs %{
  precision highp float;
  #include <texture>
  in vec4 v_color;
  in vec2 v_uv0;
  in vec2 v_maskUV;
  uniform sampler2D texture;
  uniform sampler2D maskTexture;
  uniform ClipParams {
    vec4 maskRect;
    float maskOpacity;
    float alphaThreshold;
  };
  void main () {
    // Atlas samples outside this crop must not clamp into a neighbouring NPC.
    if (v_maskUV.x < maskRect.x || v_maskUV.y < maskRect.y ||
        v_maskUV.x > maskRect.z || v_maskUV.y > maskRect.w) discard;
    vec4 stencil = vec4(1);
    CCTexture(maskTexture, v_maskUV, stencil);
    if (stencil.a * maskOpacity < alphaThreshold) discard;
    vec4 o = vec4(1);
    CCTexture(texture, v_uv0, o);
    o *= v_color;
    #if USE_BGRA
      gl_FragColor = o.bgra;
    #else
      gl_FragColor = o.rgba;
    #endif
  }
}%
