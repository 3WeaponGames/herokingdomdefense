      "glsl1": {
        "vert": "\nprecision highp float;\nuniform mat4 cc_matViewProj;\nuniform mat4 cc_matWorld;\nattribute vec3 a_position;\nattribute vec4 a_color;\n#if USE_TEXTURE\nattribute vec2 a_uv0;\n#endif\nuniform vec4 maskMap;\nvarying vec4 v_color;\nvarying vec2 v_uv0;\nvarying vec2 v_maskUV;\nvoid main () {\n  vec4 pos = vec4(a_position, 1);\n  #if CC_USE_MODEL\n    pos = cc_matViewProj * cc_matWorld * pos;\n  #else\n    pos = cc_matViewProj * pos;\n  #endif\n  v_color = a_color;\n  #if USE_TEXTURE\n    v_uv0 = a_uv0;\n    v_maskUV = a_uv0 * maskMap.xy + maskMap.zw;\n  #else\n    v_uv0 = vec2(0);\n    v_maskUV = vec2(0);\n  #endif\n  gl_Position = pos;\n}",
        "frag": "\nprecision highp float;\nvarying vec4 v_color;\nvarying vec2 v_uv0;\nvarying vec2 v_maskUV;\nuniform sampler2D texture;\nuniform sampler2D maskTexture;\nuniform vec4 maskRect;\nuniform float maskOpacity;\nuniform float alphaThreshold;\nvoid main () {\n  if (v_maskUV.x < maskRect.x || v_maskUV.y < maskRect.y ||\n      v_maskUV.x > maskRect.z || v_maskUV.y > maskRect.w) discard;\n  vec4 stencil = vec4(1);\n  vec4 maskTexture_tmp = texture2D(maskTexture, v_maskUV);\n  #if CC_USE_ALPHA_ATLAS_maskTexture\n      maskTexture_tmp.a *= texture2D(maskTexture, v_maskUV + vec2(0, 0.5)).r;\n  #endif\n  #if INPUT_IS_GAMMA\n    stencil.rgb *= (maskTexture_tmp.rgb * maskTexture_tmp.rgb);\n    stencil.a *= maskTexture_tmp.a;\n  #else\n    stencil *= maskTexture_tmp;\n  #endif\n  if (stencil.a * maskOpacity < alphaThreshold) discard;\n  vec4 o = vec4(1);\n  vec4 texture_tmp = texture2D(texture, v_uv0);\n  #if CC_USE_ALPHA_ATLAS_texture\n      texture_tmp.a *= texture2D(texture, v_uv0 + vec2(0, 0.5)).r;\n  #endif\n  #if INPUT_IS_GAMMA\n    o.rgb *= (texture_tmp.rgb * texture_tmp.rgb);\n    o.a *= texture_tmp.a;\n  #else\n    o *= texture_tmp;\n  #endif\n  o *= v_color;\n  #if USE_BGRA\n    gl_FragColor = o.bgra;\n  #else\n    gl_FragColor = o.rgba;\n  #endif\n}"
      },
      "glsl3": {
        "vert": "\nprecision highp float;\nuniform CCGlobal {\n  mat4 cc_matView;\n  mat4 cc_matViewInv;\n  mat4 cc_matProj;\n  mat4 cc_matProjInv;\n  mat4 cc_matViewProj;\n  mat4 cc_matViewProjInv;\n  vec4 cc_cameraPos;\n  vec4 cc_time;\n  mediump vec4 cc_screenSize;\n  mediump vec4 cc_screenScale;\n};\nuniform CCLocal {\n  mat4 cc_matWorld;\n  mat4 cc_matWorldIT;\n};\nin vec3 a_position;\nin vec4 a_color;\n#if USE_TEXTURE\nin vec2 a_uv0;\n#endif\nuniform ClipMap {\n  vec4 maskMap;\n};\nout vec4 v_color;\nout vec2 v_uv0;\nout vec2 v_maskUV;\nvoid main () {\n  vec4 pos = vec4(a_position, 1);\n  #if CC_USE_MODEL\n    pos = cc_matViewProj * cc_matWorld * pos;\n  #else\n    pos = cc_matViewProj * pos;\n  #endif\n  v_color = a_color;\n  #if USE_TEXTURE\n    v_uv0 = a_uv0;\n    v_maskUV = a_uv0 * maskMap.xy + maskMap.zw;\n  #else\n    v_uv0 = vec2(0);\n    v_maskUV = vec2(0);\n  #endif\n  gl_Position = pos;\n}",
        "frag": "\nprecision highp float;\nin vec4 v_color;\nin vec2 v_uv0;\nin vec2 v_maskUV;\nuniform sampler2D texture;\nuniform sampler2D maskTexture;\nuniform ClipParams {\n  vec4 maskRect;\n  float maskOpacity;\n  float alphaThreshold;\n};\nvoid main () {\n  if (v_maskUV.x < maskRect.x || v_maskUV.y < maskRect.y ||\n      v_maskUV.x > maskRect.z || v_maskUV.y > maskRect.w) discard;\n  vec4 stencil = vec4(1);\n  vec4 maskTexture_tmp = texture(maskTexture, v_maskUV);\n  #if CC_USE_ALPHA_ATLAS_maskTexture\n      maskTexture_tmp.a *= texture(maskTexture, v_maskUV + vec2(0, 0.5)).r;\n  #endif\n  #if INPUT_IS_GAMMA\n    stencil.rgb *= (maskTexture_tmp.rgb * maskTexture_tmp.rgb);\n    stencil.a *= maskTexture_tmp.a;\n  #else\n    stencil *= maskTexture_tmp;\n  #endif\n  if (stencil.a * maskOpacity < alphaThreshold) discard;\n  vec4 o = vec4(1);\n  vec4 texture_tmp = texture(texture, v_uv0);\n  #if CC_USE_ALPHA_ATLAS_texture\n      texture_tmp.a *= texture(texture, v_uv0 + vec2(0, 0.5)).r;\n  #endif\n  #if INPUT_IS_GAMMA\n    o.rgb *= (texture_tmp.rgb * texture_tmp.rgb);\n    o.a *= texture_tmp.a;\n  #else\n    o *= texture_tmp;\n  #endif\n  o *= v_color;\n  #if USE_BGRA\n    gl_FragColor = o.bgra;\n  #else\n    gl_FragColor = o.rgba;\n  #endif\n}"
